<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Staypaw.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Staypaw.Core\Staypaw.Core.csproj" />
    <ProjectReference Include="..\..\src\Staypaw.Desktop\Staypaw.Desktop.csproj" />
    <!-- Built first so StealTests can run it; nothing references its code. -->
    <ProjectReference Include="..\..\tools\Staypaw.StealTest\Staypaw.StealTest.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
