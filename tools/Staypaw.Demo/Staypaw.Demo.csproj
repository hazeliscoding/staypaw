<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A console app, so it can say what it's doing. -->
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Staypaw.Demo</RootNamespace>
    <!-- Physical pixels, so its window, the hole in it and the recording line up. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <!-- Built first so the demo can run it; nothing references its code. -->
    <ProjectReference Include="..\Staypaw.StealTest\Staypaw.StealTest.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
