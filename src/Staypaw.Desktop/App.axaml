<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Staypaw.Desktop.App"
             Name="Staypaw">
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="avares://Staypaw/Assets/staypaw.ico" ToolTipText="Staypaw">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Quit Staypaw" Click="OnQuit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
