<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Staypaw.Desktop.App"
             Name="Staypaw">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Staypaw/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- The Windows tray menu is drawn with Avalonia controls, so it needs a theme even with no window. -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <!-- The menu is built in App.axaml.cs, because it shows what the watcher knows. -->
      <TrayIcon Icon="avares://Staypaw/Assets/staypaw.ico" ToolTipText="Staypaw" />
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
