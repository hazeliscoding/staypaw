<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Staypaw.Desktop</RootNamespace>
    <AssemblyName>Staypaw</AssemblyName>
    <!-- Shown by Windows as the file description, e.g. in Task Manager. -->
    <AssemblyTitle>Staypaw</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\docs\brand\staypaw.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Staypaw.Core\Staypaw.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Oopsling.Avalonia" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\docs\brand\staypaw.ico" Link="Assets\staypaw.ico" />
    <AvaloniaResource Include="..\..\docs\brand\staypaw-paused.ico" Link="Assets\staypaw-paused.ico" />
    <AvaloniaResource Include="..\..\docs\brand\calla\slow-blink-256.png" Link="Assets\slow-blink-256.png" />
  </ItemGroup>

</Project>
